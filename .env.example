# B12 Store Solution - frontend (Vite / Vercel)
#
# PUBLIC values only. Every VITE_ variable is compiled into the browser bundle
# and visible to anyone. Never put a secret key, database password, Anthropic,
# Resend or Google client secret here; those belong in server/.env (Railway).
# `npm run build` refuses secret-looking VITE_ variables.
#
# Set these in Vercel -> Project -> Settings -> Environment Variables:
#   "Preview" scope    -> staging values
#   "Production" scope -> production values

# Supabase project URL (Supabase -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co

# Supabase PUBLISHABLE key (sb_publishable_...). Never the secret / service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backend API base URL (Railway service URL, no trailing slash)
VITE_API_URL=https://YOUR_RAILWAY_BACKEND_URL

# Frontend URL used as the auth redirect base (invite, password reset, Google).
# Leave empty on Vercel Preview so each preview uses its own origin.
# Production: https://YOUR_PRODUCTION_DOMAIN (or the production *.vercel.app URL until the domain is added).
VITE_APP_URL=

# Enabled social login buttons, comma-separated. Only "google" is configured (D5).
# Add microsoft, facebook or apple only after configuring that provider in Supabase.
VITE_AUTH_PROVIDERS=google

# Store currency, ISO 4217. Must equal CURRENCY on the server. 0- or 2-decimal currencies only.
VITE_CURRENCY=USD
