# B12 Store Solution - backend (Express / Railway)
#
# PRIVATE values. Enter real values only in Railway -> service -> Variables,
# separately for the "staging" and "production" environments.
# Never commit a real .env file. Never give any of these a VITE_ prefix.
# The server refuses to start if a required value is missing or still YOUR_...

# --- Application -------------------------------------------------------------
# staging | production. The migration/test guard also checks this.
APP_ENV=staging
NODE_ENV=production
# Railway sets PORT automatically; 3001 is only a fallback. The server binds 0.0.0.0.
PORT=3001
# fatal | error | warn | info | debug
LOG_LEVEL=info
# Store currency, ISO 4217 (0- or 2-decimal currencies). Must equal VITE_CURRENCY.
CURRENCY=USD

# --- Frontend / CORS -----------------------------------------------------------
# Frontend URL used in email links and auth redirects (no trailing slash).
APP_URL=https://YOUR_FRONTEND_URL
# Allowed browser origins, comma-separated. One "*" is allowed inside a host label
# for Vercel previews (staging only), e.g. https://b12-*-YOUR_VERCEL_TEAM.vercel.app
FRONTEND_ORIGINS=https://YOUR_FRONTEND_URL

# --- Supabase ------------------------------------------------------------------
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co
# Project reference ID (the subdomain of SUPABASE_URL). Checked against SUPABASE_URL,
# DATABASE_URL and scripts/targets.json.
SUPABASE_PROJECT_ID=YOUR_SUPABASE_PROJECT_ID
# Secret key (sb_secret_...), shown as the service-role/secret key in Supabase -> API Keys.
# Backend only: it bypasses RLS.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# No JWT secret is needed: tokens are verified with the project's public signing keys
# (JWKS at SUPABASE_URL/auth/v1/.well-known/jwks.json). The API is stateless bearer-token
# auth, so there is no session secret.

# Postgres via the Supavisor SESSION pooler (port 5432, IPv4), from
# Supabase -> Connect -> Session pooler. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR_SUPABASE_PROJECT_ID:YOUR_DATABASE_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_POOL_MAX=10

# Storage buckets (created by supabase/migrations/0003_storage.sql)
STORAGE_PRODUCT_IMAGES_BUCKET=product-images
STORAGE_SHIFT_REPORTS_BUCKET=shift-reports

# --- Email (Resend) -------------------------------------------------------------
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Sender on a domain verified in Resend, e.g. "B12 Store <reports@YOUR_DOMAIN>".
EMAIL_FROM=B12 Store <YOUR_SENDER_EMAIL>

# --- AI Restock Advisor (Anthropic) ----------------------------------------------
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# Verified at startup with the Models API; if unavailable only the advisor is disabled.
ANTHROPIC_MODEL=claude-opus-5-5

# --- CLI / CI / test runs only (NOT needed on Railway) ---------------------------
# Used by `supabase db push --linked`, advisors and the staging test suite.
# Keep them in a git-ignored server/.env.staging or GitHub "staging" environment secrets.
# Scoped personal access token limited to the one project.
SUPABASE_ACCESS_TOKEN=YOUR_SCOPED_SUPABASE_ACCESS_TOKEN
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
# Where automated report-email tests send (Resend test address; never a real inbox).
TEST_EMAIL_RECIPIENT=delivered@resend.dev
